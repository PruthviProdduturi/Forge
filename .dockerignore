# =============================================================================
# .dockerignore — repo-root build context (Spark + Airflow images)
#
# Both Spark and Airflow Dockerfiles use repo root as build context.
# Everything else is excluded to minimise upload size.
# =============================================================================

# Exclude everything by default
*

# Spark Dockerfile + config
!infra/docker/spark/
infra/docker/spark/wheels/

# Forge DQ / SDK — baked into the Spark image
!sdk/python/

# Airflow Dockerfile + plugins
!infra/docker/airflow/
infra/docker/airflow/wheels/

# Platform plugins — ForgeSparkOperator, ForgeDqGateOperator
!orchestration/airflow/plugins/
