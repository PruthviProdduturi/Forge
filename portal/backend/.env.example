# Copy to .env and update values for local development
FORGE_ENV=dev
OWNER_ALIAS=prproddu
ADLS_ACCOUNT=forgeadls{alias}dev
AZURE_TENANT_ID=<your-tenant-id>
AZURE_CLIENT_ID=
SUBSCRIPTION_ID=<your-subscription-id>
RESOURCE_GROUP=rg-forge-platform-{alias}-dev
# RG names auto-derived as rg-forge-compute-{alias}-dev / rg-forge-orchestration-{alias}-dev
# Override only if your naming differs:
# COMPUTE_RG=rg-forge-compute-prproddu-dev
# ORCH_RG=rg-forge-orchestration-prproddu-dev

# Auth
AUTH_PROVIDER=local
LOCAL_ADMIN_USER=admin
LOCAL_ADMIN_PASSWORD=forge-dev-admin
JWT_SECRET=forge-dev-secret-change-in-prod

# Airflow
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=admin

# Trino
TRINO_HOST=localhost
TRINO_PORT=8080
TRINO_CATALOG=lakehouse
TRINO_SCHEMA=default

# Purview
PURVIEW_ENDPOINT=https://purview-forge-dev.purview.azure.com

# CORS
CORS_ORIGINS=["http://localhost:3001","http://localhost:3000"]
